{
  "name": "@superfish058/dsh-llm-proxy",
  "version": "1.0.0",
  "description": "Model-level proxy routing + retry for DSH LLM requests, configurable live from the DSH 设置 page (模型代理). Selected models' baseURL hosts route through the configured proxy (proxyHost:proxyPort) while everything else stays direct, via a custom undici global dispatcher (RetryAgent over RoutingDispatcher); loopback is always direct.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/routing-dispatcher.test.js test/settings.test.js",
    "test:client": "node test/client-build.test.js",
    "test:smoke": "node test/smoke-test.mjs",
    "test:load": "node test/load-test.mjs",
    "test:global": "node test/global-fetch-probe.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "proxy",
    "clash",
    "undici",
    "rate-limit",
    "token-bucket",
    "cordis",
    "settings",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "settingsScope",
        "remote"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "lightningcss": "1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  }
}
